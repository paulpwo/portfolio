---
// Top navigation for the ListoAgent section pages.
interface Props {
  active?: "producto" | "privacidad" | "eliminacion";
}
const { active } = Astro.props;
const linkBase = "transition-colors duration-200";
const linkActive = "text-foreground";
const linkIdle = "hover:text-foreground";
---

<nav class="fixed top-0 w-full z-50 bg-background/70 backdrop-blur-xl border-b border-border">
  <div class="max-w-5xl mx-auto px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <span class="text-base font-bold tracking-tight text-foreground">Paul Werner Osinga</span>
      <span class="hidden sm:inline text-xs font-medium text-muted bg-surface-elevated px-2 py-0.5 rounded-sm uppercase tracking-widest">Developer</span>
    </a>
    <div class="flex items-center gap-5 sm:gap-7 text-sm font-medium text-muted">
      <a href="/" class={`${linkBase} ${linkIdle}`}>Inicio</a>
      <a href="/listoagent" class={`${linkBase} ${active === "producto" ? linkActive : linkIdle}`}>ListoAgent</a>
      <a href="/listoagent/privacidad" class={`hidden sm:inline ${linkBase} ${active === "privacidad" ? linkActive : linkIdle}`}>Privacidad ListoAgent</a>
      <a href="/listoagent/eliminacion-de-datos" class={`hidden sm:inline ${linkBase} ${active === "eliminacion" ? linkActive : linkIdle}`}>Eliminar datos</a>
    </div>
  </div>
</nav>
