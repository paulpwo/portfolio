---
import Layout from "../layouts/Layout.astro";
import ListoNav from "../components/ListoNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

const channels = [
  {
    name: "WhatsApp",
    color: "#25d366",
    detail:
      "Recibe y responde mensajes de WhatsApp a través de la Cloud API de Meta, con memoria por contacto.",
    icon: "whatsapp",
  },
  {
    name: "Instagram",
    color: "#e1306c",
    detail:
      "Atiende mensajes directos y comentarios de tus publicaciones desde la misma bandeja unificada.",
    icon: "instagram",
  },
  {
    name: "Facebook Pages",
    color: "#1877f2",
    detail:
      "Responde mensajes y comentarios de tu página de Facebook automáticamente con el agente de IA.",
    icon: "facebook",
  },
];

const features = [
  {
    title: "Respuestas con IA",
    body: "Un agente conversacional contesta en tu nombre con el tono y las reglas de negocio que definas.",
  },
  {
    title: "Memoria por contacto",
    body: "Cada persona tiene memoria de largo plazo: resumen, datos clave e historial propio de la conversación.",
  },
  {
    title: "Mini-CRM unificado",
    body: "Conversaciones, contactos, etiquetas y métricas de todos los canales en un solo panel.",
  },
  {
    title: "LLM multi-proveedor",
    body: "Cambia entre Anthropic, OpenAI, Google y otros desde el panel, sin tocar código.",
  },
  {
    title: "Configuración sin código",
    body: "Conecta un número, una página o una cuenta y define el comportamiento del agente desde la interfaz.",
  },
  {
    title: "Datos cifrados",
    body: "Las claves y tokens se almacenan cifrados en reposo. Tú decides qué datos retiene el agente.",
  },
];

const steps = [
  {
    n: "01",
    title: "Conecta tus canales",
    body: "Vinculas WhatsApp, Instagram o tu página de Facebook mediante las APIs oficiales de Meta.",
  },
  {
    n: "02",
    title: "Configura el agente",
    body: "Defines la persona, las reglas de negocio y el modelo de IA que responderá a tus clientes.",
  },
  {
    n: "03",
    title: "Responde en automático",
    body: "Cada mensaje o comentario entrante se procesa y el agente contesta con contexto e historial.",
  },
];
---

<Layout
  title="ListoAgent — Agente de IA para WhatsApp, Instagram y Facebook"
  description="ListoAgent conecta WhatsApp, Instagram y páginas de Facebook a un agente de IA que responde mensajes y comentarios automáticamente, con memoria por contacto y mini-CRM."
  path="/listoagent"
  includePersonSchema={false}
>
  <ListoNav active="producto" />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-accent-soft via-transparent to-transparent"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-accent/5 rounded-full blur-3xl"></div>

      <div class="relative max-w-5xl mx-auto px-6 lg:px-8 pt-36 pb-20 text-center">
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-accent bg-accent-soft border border-accent/10 px-3 py-1.5 rounded-md uppercase tracking-widest mb-6">
          <span class="w-1.5 h-1.5 bg-accent rounded-full animate-pulse"></span>
          App de Meta · WhatsApp · Instagram · Facebook
        </span>

        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight leading-[1.08] mb-6">
          Un agente de IA que responde<br class="hidden sm:block" />
          <span class="text-muted">tus mensajes y comentarios</span>
        </h1>

        <p class="text-base sm:text-lg text-muted leading-relaxed max-w-2xl mx-auto mb-10">
          <strong class="text-foreground font-semibold">ListoAgent</strong> conecta tus canales de
          WhatsApp, Instagram y Facebook a un agente conversacional que atiende a tus clientes
          automáticamente, con memoria por contacto y un mini-CRM unificado.
        </p>

        <div class="flex flex-wrap gap-3 justify-center">
          <a href="#canales"
            class="inline-flex items-center gap-2.5 px-5 py-2.5 text-sm font-semibold bg-foreground text-background rounded-lg hover:opacity-90 transition-opacity">
            Ver canales
          </a>
          <a href="/listoagent/privacidad"
            class="inline-flex items-center gap-2.5 px-5 py-2.5 text-sm font-semibold border border-border text-muted rounded-lg hover:text-foreground hover:border-border-hover transition-colors">
            Política de privacidad
          </a>
        </div>
      </div>
    </section>

    <!-- Channels -->
    <section id="canales" class="py-24 border-t border-border">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">
        <div class="flex items-center gap-4 mb-16">
          <h2 class="text-sm font-bold text-accent uppercase tracking-[0.15em]">Canales conectados</h2>
          <div class="h-px flex-1 bg-border"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {channels.map((c) => (
            <div class="bg-surface border border-border rounded-xl p-6 hover:border-border-hover transition-colors duration-200">
              <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-5" style={`background-color: ${c.color}1a`}>
                {c.icon === "whatsapp" && (
                  <svg class="w-6 h-6" style={`color: ${c.color}`} fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                )}
                {c.icon === "instagram" && (
                  <svg class="w-6 h-6" style={`color: ${c.color}`} fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                )}
                {c.icon === "facebook" && (
                  <svg class="w-6 h-6" style={`color: ${c.color}`} fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                )}
              </div>
              <h3 class="text-lg font-bold text-foreground mb-2">{c.name}</h3>
              <p class="text-sm text-muted leading-relaxed">{c.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="py-24 border-t border-border">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">
        <div class="flex items-center gap-4 mb-16">
          <h2 class="text-sm font-bold text-accent uppercase tracking-[0.15em]">Qué hace</h2>
          <div class="h-px flex-1 bg-border"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f) => (
            <div class="bg-surface border border-border rounded-xl p-6">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div>
                  <h3 class="text-base font-bold text-foreground mb-1.5">{f.title}</h3>
                  <p class="text-sm text-muted leading-relaxed">{f.body}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="py-24 border-t border-border">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">
        <div class="flex items-center gap-4 mb-16">
          <h2 class="text-sm font-bold text-accent uppercase tracking-[0.15em]">Cómo funciona</h2>
          <div class="h-px flex-1 bg-border"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {steps.map((s) => (
            <div class="bg-surface border border-border rounded-xl p-6">
              <div class="text-sm font-extrabold text-accent tracking-widest mb-4">{s.n}</div>
              <h3 class="text-lg font-bold text-foreground mb-2">{s.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Meta platform usage + privacy -->
    <section class="py-24 border-t border-border">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">
        <div class="bg-surface border border-border rounded-2xl p-8 sm:p-10">
          <h2 class="text-2xl font-bold text-foreground mb-4">Uso de las plataformas de Meta</h2>
          <p class="text-base text-muted leading-relaxed mb-4 max-w-none">
            ListoAgent accede únicamente a los datos necesarios para mantener la conversación:
            mensajes y comentarios entrantes, identificadores públicos del perfil y los metadatos
            del mensaje. El contenido se procesa con proveedores de IA externos para generar las
            respuestas. No vendemos tus datos ni los de tus clientes.
          </p>
          <p class="text-base text-muted leading-relaxed mb-6">
            Para conocer en detalle qué información se recopila, cómo se usa, con quién se comparte
            y cómo solicitar su eliminación, consulta la política de privacidad.
          </p>
          <a href="/listoagent/privacidad"
            class="inline-flex items-center gap-2.5 px-5 py-2.5 text-sm font-semibold bg-foreground text-background rounded-lg hover:opacity-90 transition-opacity">
            Leer la política de privacidad
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
