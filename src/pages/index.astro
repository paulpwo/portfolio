---
/*
THESIS: A Swiss International Style CV poster: the grid is the design. It refuses the
category's card stacks, icons and glow in favor of type, alignment and empty space.
OWN-WORLD: Cool concrete gray ground, near-black ink, one Swiss red square. Schibsted Grotesk
only, flush-left ragged-right, 12-column grid, 1px black rules, no radii, no shadows.
STORY: The name and role land like a poster headline, the two numerals give scale, the
experience rows read left to right as when, who, what, and the contact column never leaves.
FIRST VIEWPORT: Red square top-left, name across 12 columns at poster scale, role below,
numerals 15+ and 3+ in columns 1-6, contact links stacked in columns 9-12.
FORM: Grounded candidate #2, staging: three distances (poster, rows, details). Seed key 60201a9c.
System rules live in DESIGN.md.
*/
import Layout from '../layouts/Layout.astro';
import data from '../data/data.json';

const { metrics, skills, experience } = data;
const waLink =
  'https://wa.me/573025780000?text=Hola%20Paul%2C%20vi%20tu%20perfil%20y%20me%20gustar%C3%ADa%20hablar%20contigo';
const fontsHref =
  'https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;800;900&display=swap';
---

<Layout
  title="Paul Werner Osinga · Technical Leader & Full Stack Developer"
  description="Technical Leader & Full Stack Developer con más de 15 años de experiencia. Creador de Taly, agente de IA de TalentPitch con RAG, tools y skills. Arquitecturas cloud con Laravel, Flutter, Go y AWS."
  fontsHref={fontsHref}
  themeColor="#e9eaec"
>
  <header class="bar grid">
    <span class="bar__a">Paul Werner Osinga</span>
    <span class="bar__b">Bogotá, Colombia</span>
    <nav class="bar__c" aria-label="Secciones">
      <a href="#experiencia">Experiencia</a>
      <a href="#stack">Stack</a>
      <a href="#contacto">Contacto</a>
      <a href="https://www.listoagent.net/" target="_blank" rel="noopener">ListoAgent</a>
    </nav>
  </header>

  <main>
    <section class="hero grid" aria-labelledby="name">
      <div class="red" aria-hidden="true"></div>
      <h1 id="name">Paul Werner<br />Osinga</h1>
      <p class="role">Technical Leader &amp;<br />Full Stack Developer</p>
      <p class="summary">
        Más de 15 años construyendo y liderando productos digitales. Arquitecturas cloud con
        Laravel, Flutter y AWS/GCloud, desde la estrategia hasta la entrega en producción.
      </p>
      <p class="summary summary--now">
        Hoy, detrás de <strong>Taly</strong>: el agente de IA de TalentPitch que automatiza gran
        parte de la comunicación con clientes, con capacidades agénticas, RAG, tools y skills.
      </p>
      <dl class="nums">
        {metrics.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
      <div class="reach">
        <p class="label">Disponible</p>
        <ul>
          <li><a href="mailto:paulpwo@gmail.com">paulpwo@gmail.com</a></li>
          <li><a href={waLink} target="_blank" rel="noopener">WhatsApp +57 302 578 0000</a></li>
          <li><a href="https://linkedin.com/in/paulpwo" target="_blank" rel="noopener">LinkedIn in/paulpwo</a></li>
          <li><a href="https://github.com/paulpwo" target="_blank" rel="noopener">GitHub paulpwo</a></li>
        </ul>
      </div>
    </section>

    <section id="experiencia" class="part" aria-labelledby="h-exp">
      <h2 id="h-exp" class="grid part__h"><span>Experiencia</span></h2>
      {experience.map((job) => (
        <article class="job grid">
          <p class="job__when">
            {job.period}
            <span>{job.type}</span>
          </p>
          <div class="job__who">
            <h3>{job.role}</h3>
            <p class="job__co">
          {'url' in job && job.url ? (
            <a href={job.url} target="_blank" rel="noopener">{job.company} ↗</a>
          ) : (
            job.company
          )}
        </p>
            <p class="job__desc">{job.description}</p>
          </div>
          <ul class="job__what">
            {job.achievements.map((a) => <li>{a}</li>)}
          </ul>
        </article>
      ))}
    </section>

    <section id="stack" class="part" aria-labelledby="h-stack">
      <h2 id="h-stack" class="grid part__h"><span>Stack</span></h2>
      <div class="stack grid">
        {Object.entries(skills).map(([cat, items]) => (
          <div class="stack__col">
            <h3>{cat}</h3>
            <ul>
              {items.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="contacto" class="part" aria-labelledby="h-contact">
      <h2 id="h-contact" class="grid part__h"><span>Contacto</span></h2>
      <div class="contact grid">
        <p class="contact__lead">Hablemos de tu próximo proyecto.</p>
        <p class="contact__note">
          Disponible para roles de liderazgo técnico, consultoría en arquitectura cloud y
          desarrollo full stack.
        </p>
        <ul class="contact__list">
          <li><span>Email</span><a href="mailto:paulpwo@gmail.com">paulpwo@gmail.com</a></li>
          <li><span>WhatsApp</span><a href={waLink} target="_blank" rel="noopener">+57 302 578 0000</a></li>
          <li><span>LinkedIn</span><a href="https://linkedin.com/in/paulpwo" target="_blank" rel="noopener">in/paulpwo</a></li>
          <li><span>GitHub</span><a href="https://github.com/paulpwo" target="_blank" rel="noopener">paulpwo</a></li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="foot grid">
    <span class="foot__a">© 2026 Paul Werner Osinga Leon</span>
    <span class="foot__b">paulosinga.net</span>
    <nav class="foot__c" aria-label="ListoAgent">
      <a href="https://www.listoagent.net/" target="_blank" rel="noopener">listoagent.net ↗</a>
      <a href="/listoagent">ListoAgent en este sitio</a>
      <a href="/listoagent/privacidad">Privacidad</a>
      <a href="/listoagent/eliminacion-de-datos">Eliminación de datos</a>
    </nav>
  </footer>
</Layout>

<style is:global>
  :root {
    --ground: oklch(0.93 0.004 250);
    --ink: oklch(0.17 0.005 250);
    --ink-2: oklch(0.42 0.006 250);
    --red: oklch(0.58 0.21 27);
    --gutter: 24px;
    --margin: 40px;
    --font: 'Schibsted Grotesk', 'Helvetica Neue', Arial, sans-serif;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  h1,
  h2,
  h3,
  p,
  ul,
  dl,
  dd {
    margin: 0;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  a:hover {
    background-size: 100% 1px;
  }
  :focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    padding: 0 var(--margin);
    max-width: 1440px;
    margin: 0 auto;
  }

  .bar {
    padding-top: 20px;
    padding-bottom: 20px;
    font-size: 14px;
    font-weight: 500;
  }
  .bar__a {
    grid-column: 1 / 5;
  }
  .bar__b {
    grid-column: 5 / 9;
    color: var(--ink-2);
  }
  .bar__c {
    grid-column: 9 / 13;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }

  .hero {
    padding-top: 12vh;
    padding-bottom: 96px;
    row-gap: 0;
    align-items: start;
  }
  .red {
    grid-column: 1 / 2;
    grid-row: 1;
    aspect-ratio: 1;
    background: var(--red);
    margin-bottom: 28px;
    max-width: 88px;
  }
  h1 {
    grid-column: 1 / 13;
    grid-row: 2;
    font-weight: 800;
    font-size: clamp(3rem, 11.4vw, 10.5rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    margin-left: -0.04em;
  }
  .role {
    grid-column: 1 / 7;
    grid-row: 3;
    margin-top: 40px;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .summary {
    grid-column: 7 / 12;
    grid-row: 3;
    margin-top: 44px;
    font-size: 16px;
    color: var(--ink-2);
    max-width: 52ch;
  }
  .summary--now {
    grid-row: 4;
    margin-top: 16px;
    color: var(--ink);
  }
  .summary strong {
    font-weight: 700;
  }
  .nums {
    grid-column: 1 / 9;
    grid-row: 5;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
    margin-top: 80px;
    border-top: 1px solid var(--ink);
  }
  .nums div {
    display: flex;
    flex-direction: column-reverse;
    padding-top: 12px;
  }
  .nums dt {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .nums dd {
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .reach {
    grid-column: 9 / 13;
    grid-row: 5;
    margin-top: 80px;
    border-top: 1px solid var(--ink);
    padding-top: 12px;
  }
  .label {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .label::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--red);
  }
  .reach li {
    padding: 4px 0;
    font-size: 15px;
    font-weight: 500;
  }

  .part {
    padding-top: 40px;
  }
  .part__h {
    font-size: 14px;
    font-weight: 700;
    padding-bottom: 12px;
    padding-top: 12px;
    position: relative;
  }
  .part__h::after {
    content: '';
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    top: 0;
    height: 2px;
    background: var(--ink);
  }
  .part__h span {
    grid-column: 1 / 13;
  }

  .job {
    padding-top: 28px;
    padding-bottom: 36px;
    position: relative;
  }
  .job + .job::before {
    content: '';
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    top: 0;
    height: 1px;
    background: oklch(0.17 0.005 250 / 0.22);
  }
  .job__when {
    grid-column: 1 / 4;
    font-size: 15px;
    font-weight: 500;
  }
  .job__when span {
    display: block;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 400;
  }
  .job__who {
    grid-column: 4 / 9;
    padding-right: 24px;
  }
  .job__who h3 {
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .job__co {
    font-size: 15px;
    font-weight: 500;
    margin-top: 6px;
  }
  .job__co a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .job__co a:hover {
    text-decoration-color: var(--red);
  }
  .job__desc {
    font-size: 15px;
    color: var(--ink-2);
    margin-top: 12px;
    max-width: 50ch;
  }
  .job__what {
    grid-column: 9 / 13;
    font-size: 14px;
  }
  .job__what li {
    padding: 3px 0;
    line-height: 1.4;
  }

  .stack {
    padding-top: 28px;
    padding-bottom: 32px;
    row-gap: 36px;
  }
  .stack__col {
    grid-column: span 2;
  }
  .stack__col:first-child {
    grid-column: 1 / 4;
  }
  .stack__col h3 {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .stack__col li {
    font-size: 15px;
    padding: 2px 0;
  }

  .contact {
    padding-top: 28px;
    padding-bottom: 120px;
    align-items: start;
  }
  .contact__lead {
    grid-column: 1 / 8;
    font-size: clamp(2.25rem, 5.5vw, 4.75rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .contact__note {
    grid-column: 1 / 7;
    grid-row: 2;
    margin-top: 24px;
    color: var(--ink-2);
    max-width: 48ch;
  }
  .contact__list {
    grid-column: 9 / 13;
    grid-row: 1 / 3;
  }
  .contact__list li {
    display: flex;
    flex-direction: column;
    padding: 10px 0;
    border-top: 1px solid var(--ink);
  }
  .contact__list span {
    font-size: 13px;
    color: var(--ink-2);
  }
  .contact__list a {
    font-size: 17px;
    font-weight: 500;
    align-self: flex-start;
  }

  .foot {
    padding-top: 16px;
    padding-bottom: 64px;
    font-size: 13px;
    color: var(--ink-2);
    position: relative;
  }
  .foot::before {
    content: '';
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    top: 0;
    height: 2px;
    background: var(--ink);
  }
  .foot__a {
    grid-column: 1 / 5;
  }
  .foot__b {
    grid-column: 5 / 9;
  }
  .foot__c {
    grid-column: 9 / 13;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  @media (max-width: 1000px) {
    :root {
      --margin: 24px;
      --gutter: 16px;
    }
    .summary {
      grid-column: 1 / 13;
      grid-row: 4;
      margin-top: 20px;
    }
    .summary--now {
      grid-row: 5;
      margin-top: 12px;
    }
    .nums {
      grid-row: 6;
      grid-column: 1 / 13;
      margin-top: 56px;
    }
    .reach {
      grid-row: 7;
      grid-column: 1 / 13;
      margin-top: 40px;
    }
    .role {
      grid-column: 1 / 13;
    }
    .job__when {
      grid-column: 1 / 13;
      margin-bottom: 8px;
    }
    .job__who {
      grid-column: 1 / 8;
    }
    .job__what {
      grid-column: 8 / 13;
    }
    .stack__col,
    .stack__col:first-child {
      grid-column: span 4;
    }
  }
  @media (max-width: 640px) {
    :root {
      --margin: 16px;
    }
    .bar__a {
      grid-column: 1 / 13;
    }
    .bar__b {
      display: none;
    }
    .bar__c {
      grid-column: 1 / 13;
      margin-top: 8px;
    }
    .hero {
      padding-top: 48px;
      padding-bottom: 64px;
    }
    .red {
      grid-column: 1 / 3;
      max-width: 56px;
    }
    h1 {
      font-size: clamp(2.75rem, 15.5vw, 5rem);
    }
    .role {
      margin-top: 24px;
    }
    .nums dd {
      font-size: 3.5rem;
    }
    .job__who,
    .job__what {
      grid-column: 1 / 13;
    }
    .job__who {
      padding-right: 0;
    }
    .job__what {
      margin-top: 16px;
      padding-left: 16px;
      border-left: 1px solid var(--ink);
    }
    .stack__col,
    .stack__col:first-child {
      grid-column: span 6;
    }
    .contact__lead,
    .contact__note,
    .contact__list {
      grid-column: 1 / 13;
      grid-row: auto;
    }
    .contact__list {
      margin-top: 40px;
    }
    .foot__a,
    .foot__b,
    .foot__c {
      grid-column: 1 / 13;
    }
    .foot__c {
      margin-top: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    a {
      transition: none;
    }
  }
</style>
