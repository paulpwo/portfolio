---
import Layout from "../../layouts/Layout.astro";
import ListoNav from "../../components/ListoNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";

const lastUpdated = "18 de junio de 2026";
const contactEmail = "paulpwo@gmail.com";
const subject = "Solicitud de eliminación de datos - ListoAgent";
const mailto = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}`;

const steps = [
  {
    n: "01",
    title: "Escríbenos un correo",
    body: `Envía un mensaje a ${contactEmail} con el asunto "Solicitud de eliminación de datos - ListoAgent".`,
  },
  {
    n: "02",
    title: "Identifica tu conversación",
    body: "Indica el canal por el que interactuaste (WhatsApp, Instagram o Facebook) y el identificador con el que escribiste: número de teléfono, nombre de usuario o nombre del perfil.",
  },
  {
    n: "03",
    title: "Confirmamos y eliminamos",
    body: "Validamos la solicitud, confirmamos la recepción y eliminamos la información asociada dentro de los 30 días siguientes.",
  },
];

const deleted = [
  "El contenido de tus mensajes y comentarios procesados por el agente.",
  "Los archivos multimedia recibidos (imágenes, audio, documentos).",
  "La memoria y los resúmenes generados sobre tu contacto.",
  "Los identificadores de perfil y metadatos asociados a tu conversación.",
];
---

<Layout
  title="Eliminación de datos — ListoAgent"
  description="Instrucciones para solicitar la eliminación de tus datos en ListoAgent. URL designada para las solicitudes de eliminación de datos de las apps de Meta (Facebook, Instagram, WhatsApp)."
  path="/listoagent/eliminacion-de-datos"
  includePersonSchema={false}
>
  <ListoNav active="eliminacion" />

  <main>
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-accent-soft via-transparent to-transparent"></div>
      <div class="relative max-w-3xl mx-auto px-6 lg:px-8 pt-36 pb-12">
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-accent bg-accent-soft border border-accent/10 px-3 py-1.5 rounded-md uppercase tracking-widest mb-6">
          ListoAgent
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Eliminación de datos</h1>
        <p class="text-base text-muted leading-relaxed max-w-2xl">
          Esta página explica cómo solicitar la eliminación de los datos que ListoAgent procesa de tus
          conversaciones en WhatsApp, Instagram y Facebook. Es la URL designada para las solicitudes de
          eliminación de datos requeridas por las plataformas de Meta.
        </p>
        <p class="text-sm text-muted-soft mt-4">Última actualización: {lastUpdated}</p>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-6 lg:px-8 pb-24">
      <!-- Steps -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12">
        {steps.map((s) => (
          <div class="bg-surface border border-border rounded-xl p-6">
            <div class="text-sm font-extrabold text-accent tracking-widest mb-4">{s.n}</div>
            <h3 class="text-base font-bold text-foreground mb-2">{s.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="bg-surface border border-border rounded-2xl p-8 sm:p-10 mb-12">
        <h2 class="text-xl font-bold text-foreground mb-3">Solicita la eliminación ahora</h2>
        <p class="text-base text-muted leading-relaxed mb-6">
          Haz clic en el botón para abrir un correo con el asunto correcto. Recuerda incluir el canal y
          tu identificador para que podamos localizar tu información.
        </p>
        <a href={mailto}
          class="inline-flex items-center gap-2.5 px-5 py-2.5 text-sm font-semibold bg-foreground text-background rounded-lg hover:opacity-90 transition-opacity">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
          Escribir a {contactEmail}
        </a>
      </div>

      <!-- What gets deleted -->
      <section class="text-base text-muted leading-relaxed">
        <h2 class="text-xl font-bold text-foreground mb-4">Qué se elimina</h2>
        <ul class="space-y-2.5 mb-8">
          {deleted.map((d) => (
            <li class="flex gap-2.5">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>{d}</span>
            </li>
          ))}
        </ul>
        <p class="mb-3">
          La eliminación es permanente. Conservaremos únicamente la información que la ley nos exija
          mantener, de forma minimizada y solo durante el plazo legal correspondiente.
        </p>
        <p>
          Para más detalle sobre qué datos tratamos y por qué, consulta la
          <a href="/listoagent/privacidad" class="text-accent hover:underline">política de privacidad de ListoAgent</a>.
        </p>
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>
